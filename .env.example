# ============================================================
# Pilah.in — Backend Environment Variables (TEMPLATE)
# Copy file ini menjadi `.env` lalu sesuaikan nilainya.
#   Windows : copy .env.example .env
#   Linux/Mac: cp .env.example .env
# ============================================================

# --- Django ---
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL via docker compose) ---
DATABASE_NAME=pilah_in
DATABASE_USER=postgres
DATABASE_PASSWORD=pilah_postgres_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- Redis (via docker compose) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- ML Service (FastAPI via docker compose, port 8001) ---
# NB: key ini dibaca oleh config/settings.py
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT=30

# --- JWT (dalam menit) ---
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email (development: print ke console) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
